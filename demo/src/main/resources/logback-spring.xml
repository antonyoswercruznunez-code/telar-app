<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>

    <!-- Archivo diario en logs/, se conservan 30 días -->
    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/telar-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/telar-app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${PATRON}</pattern></encoder>
    </appender>

    <logger name="com.example.demo" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
